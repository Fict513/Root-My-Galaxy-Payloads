+  int stable = 0;
+  struct timespec now_ts;
+  for (int poll = 0; poll < 45; ++poll) {
+    SYSCHK(clock_gettime(CLOCK_BOOTTIME, &now_ts));
+    if (now_ts.tv_sec >= APP_MIN_BOOT_UPTIME_SEC) {
+      return;
+    }
+    if (now_ts.tv_sec >= QUIET_FLOOR_SEC && stable >= QUIET_STABLE_SAMPLES) {
